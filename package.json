{
  "name": "snake-appraise",
  "version": "0.0.0",
  "scripts": {
    "uvm": "npx @dcloudio/uvm@latest",
    "uvm-rm": "node ./scripts/postupgrade.js",
    "dev:custom": "uni -p",
    "dev": "uni",
    "dev:en": "cross-env VITE_DEFAULT_LOCALE=en-US uni",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "dev:mp-jd": "uni -p mp-jd",
    "dev:mp-kuaishou": "uni -p mp-kuaishou",
    "dev:mp-lark": "uni -p mp-lark",
    "dev:mp-qq": "uni -p mp-qq",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-xhs": "uni -p mp-xhs",
    "dev:quickapp-webview": "uni -p quickapp-webview",
    "dev:quickapp-webview-huawei": "uni -p quickapp-webview-huawei",
    "dev:quickapp-webview-union": "uni -p quickapp-webview-union",
    "build:app": "uni build -p app",
    "build:custom": "uni build -p",
    "build": "uni build",
    "build:en": "cross-env VITE_DEFAULT_LOCALE=en-US uni build",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:mp-baidu": "uni build -p mp-baidu",
    "build:mp-jd": "uni build -p mp-jd",
    "build:mp-kuaishou": "uni build -p mp-kuaishou",
    "build:mp-lark": "uni build -p mp-lark",
    "build:mp-qq": "uni build -p mp-qq",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-xhs": "uni build -p mp-xhs",
    "build:quickapp-webview": "uni build -p quickapp-webview",
    "build:quickapp-webview-huawei": "uni build -p quickapp-webview-huawei",
    "build:quickapp-webview-union": "uni build -p quickapp-webview-union",
    "prepare": "husky init && husky install",
    "cz": "czg",
    "type-check": "vue-tsc --noEmit",
    "lint:eslint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .eslintignore",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --fix"
  },
  "lint-staged": {
    "**/*.{html,vue,ts,cjs,json,md}": [
      "prettier --write"
    ],
    "**/*.{vue,js,ts,jsx,tsx}": [
      "eslint --cache --fix"
    ],
    "**/*.{vue,css,scss,html}": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080520251106001",
    "@dcloudio/uni-app-plus": "3.0.0-4080520251106001",
    "@dcloudio/uni-components": "3.0.0-4080520251106001",
    "@dcloudio/uni-h5": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-harmony": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080520251106001",
    "dayjs": "^1.11.13",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "umtrack-alipay": "^2.8.0",
    "umtrack-wx": "^2.8.0",
    "vue": "3.5.24",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@dcloudio/types": "3.4.19",
    "@dcloudio/uni-automator": "3.0.0-4080520251106001",
    "@dcloudio/uni-cli-shared": "3.0.0-4080520251106001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080520251106001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080520251106001",
    "@mini-types/alipay": "^3.0.14",
    "@types/node": "^20.17.9",
    "@types/wechat-miniprogram": "^3.4.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@uni-helper/uni-types": "^1.0.0-alpha.3",
    "@uni-helper/vite-plugin-uni-layouts": "^0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "^0.2.8",
    "@vue/runtime-core": "3.5.24",
    "@vue/tsconfig": "^0.1.3",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "czg": "^1.11.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.78.0",
    "stylelint": "^16.17.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended": "^15.0.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^5.7.2",
    "unocss": "^0.58.9",
    "unocss-applet": "^0.7.8",
    "vite": "5.2.8",
    "vite-plugin-restart": "^0.4.2",
    "vue-tsc": "^1.8.27"
  }
}
