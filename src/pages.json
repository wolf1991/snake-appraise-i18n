{
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/tabbar/main",
      "style": {
        "navigationBarTitleText": "%pages.main%",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/tabbar/user",
      "style": {
        "navigationBarTitleText": "%pages.user%"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/login",
      "pages": [
        {
          "path": "oauth",
          "style": {
            "navigationBarTitleText": "%pages.login%",
            "navigationStyle": "custom",
            "mp-alipay": {
              "transparentTitle": "always",
              "titlePenetrate": "YES"
            }
          }
        }
      ]
    },
    {
      "root": "pages/user",
      "pages": [
        {
          "path": "address/address",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.address%"
          }
        },
        {
          "path": "address/addressManage",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.addressManage%"
          }
        },
        {
          "path": "setting/index",
          "style": {
            "navigationBarTitleText": "%pages.settings%"
          }
        },
        {
          "path": "setting/cancelAccount",
          "style": {
            "navigationBarTitleText": "%pages.cancelAccount%"
          }
        },
        {
          "path": "devConfig",
          "style": {
            "navigationBarTitleText": "%pages.devConfig%"
          }
        }
      ]
    },
    {
      "root": "pages/custom",
      "pages": [
        {
          "path": "dydetail",
          "style": {
            "navigationBarTitleText": "%pages.dydetail%"
          }
        },
        {
          "path": "cms",
          "style": {
             "enablePullDownRefresh": true,
            "navigationBarTitleText": "%pages.cms%"
          }
        },
        {
          "path": "webview",
          "style": {
            "navigationBarTitleText": "%pages.webview%"
          }
        },
        {
          "path": "cashier",
          "style": {
            "navigationBarTitleText": "%pages.cashier%"
          }
        }
      ]
    },
    {
      "root": "pages/identify",
      "pages": [
        {
          "path": "cashier",
          "style": {
            "navigationBarTitleText": "%pages.cashier%"
          }
        }
      ]
    },
    {
      "root": "pages/appraise",
      "pages": [
        {
          "path": "allAppraisers",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.allAppraisers%",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "appraiser",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.appraiser%",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "appraiserDetail",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.appraiserDetail%",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "appraiseCheck",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.appraiseCheck%",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "selectReason",
          "style": {
            "navigationBarTitleText": "%pages.selectReason%"
          }
        },
        {
          "path": "selectImage",
          "style": {
            "navigationBarTitleText": "%pages.selectImage%"
          }
        },
        {
          "path": "selectBrand",
          "style": {
            "navigationBarTitleText": "%pages.selectBrand%"
          }
        },
        {
          "path": "identify",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.identifyInfo%"
          }
        },
        {
          "path": "supplement",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.supplement%"
          }
        },
        {
          "path": "onlineEditing",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.appraiserStatus%"
          }
        },
        {
          "path": "codePurchase",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.codePurchase%"
          }
        },
        {
          "path": "createIdentify",
          "style": {
            "navigationBarTitleText": "%pages.appraiserDetail%"
          }
        }
      ]
    },
    {
      "root": "pages/examPaper",
      "pages": [
        {
          "path": "examPaperList",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.examPaperList%",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "examPaperDetail",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.examPaperDetail%",
            "enablePullDownRefresh": false
          }
        },
        {
          "path": "answer",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.answer%",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/order",
      "pages": [
        {
          "path": "orderList",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.orderList%"
          }
        },
        {
          "path": "orderDetail",
          "needLogin": false,
          "style": {
            "navigationBarTitleText": "%pages.orderDetail%"
          }
        },
        {
          "path": "codeOrderList",
          "needLogin": true,
          "style": {
            "navigationBarTitleText": "%pages.codeOrderList%"
          }
        }
      ]
    }
  ],
  //定义预加载
  "preloadRule": {
    //当访问到该路由的页面时，会顺带预加载对应的包(可以是主包，也可以是子包)
    "pages/tabbar/main": {
      "network": "wifi", // 仅在 WiFi 下预加载，节省流量
      "packages": ["pages/order", "pages/appraise"]
    },
    "pages/tabbar/user": {
      "network": "wifi", // 仅在 WiFi 下预加载，节省流量
      "packages": ["pages/login", "pages/user"]
      // 移除 pages/appraise，减少不必要的预加载
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "%pages.appName%",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^snake-(.*)": "@/components/snake-$1/snake-$1.vue"
    }
  },
  "tabBar": {
    "color": "#A8AAB0",
    "selectedColor": "#404155",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "height": "50px",
    "fontSize": "10px",
    "iconWidth": "24px",
    "spacing": "3px",
    "list": [
      {
        "pagePath": "pages/tabbar/main",
        "text": "%pages.main%",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home_on.png"
      },
      {
        "pagePath": "pages/tabbar/user",
        "text": "%pages.user%",
        "iconPath": "static/tabbar/my.png",
        "selectedIconPath": "static/tabbar/my_on.png"
      }
    ]
  }
}
