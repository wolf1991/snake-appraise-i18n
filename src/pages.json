  //定义预加载
  "preloadRule": {
    //当访问到该路由的页面时，会顺带预加载对应的包(可以是主包，也可以是子包)
    "pages/tabbar/main": {
      "network": "all",
      "packages": ["pages/order", "pages/appraise"]
    },
    "pages/tabbar/user": {
      "network": "all",
      "packages": ["pages/login", "pages/user", "pages/appraise"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "SNAKE鉴别",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F8F8F8"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
      "^snake-(.*)": "@/components/snake-$1/snake-$1.vue"
    }
  },
  "tabBar": {
    "color": "#A8AAB0",
    "selectedColor": "#404155",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "height": "50px",
    "fontSize": "10px",
    "iconWidth": "24px",
    "spacing": "3px",
    "list": [
      {
        "pagePath": "pages/tabbar/main",
        "text": "鉴别",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home_on.png"
      },
      {
        "pagePath": "pages/tabbar/user",
        "text": "我的",
        "iconPath": "static/tabbar/my.png",
        "selectedIconPath": "static/tabbar/my_on.png"
      }
    ]
  }
}
